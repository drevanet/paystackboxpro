generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubscriptionStatus {
  ACTIVE
  NON_RENEWING
  PAST_DUE
  CANCELLED
  INACTIVE
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  passwordHash        String
  paystackCustomerCode String?
  subscriptionCode    String?
  subscriptionStatus  SubscriptionStatus @default(INACTIVE)
  planKey             String?
  currentPeriodEnd    DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  projects            Project[]
  payments            Payment[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  frontImage  String?
  backImage   String?
  leftImage   String?
  rightImage  String?
  topImage   String?
  bottomImage String?
  background  String   @default("#111111")
  scale       Float    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Payment {
  id                   String   @id @default(cuid())
  reference            String   @unique
  userId               String
  planKey              String
  amount               Int
  currency             String   @default("NGN")
  status               String
  paystackCustomerCode String?
  createdAt            DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
